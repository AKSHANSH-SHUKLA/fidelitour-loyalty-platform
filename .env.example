# MongoDB — cluster Atlas conseillé (mongodb+srv://…)
MONGO_URL=

# JWT — générer : openssl rand -hex 32
JWT_SECRET=

# B2Brouter (facturation électronique) — clé test_ ou prod_
B2BROUTER_API_KEY=
B2BROUTER_WEBHOOK_SECRET=

# Optionnel : autoriser le webhook facturation en mode Mock (tests uniquement)
# FACTURATION_ALLOW_MOCK_WEBHOOK=1
